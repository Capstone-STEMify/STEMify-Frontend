  "activities": [
    {
      "id": "activity_square_1",
      "name": "Assemble a Square Frame",
      "description": "Learn how to connect 4 straws using 4 connectors to form a square.",
      "difficulty": "beginner",
      "estimatedTime": 600,
      "objectives": [
        "Practice placing components precisely",
        "Understand 4-port connectors",
        "Learn how to build closed-loop structures"
      ],
      "steps": [
        {
          "id": "step_1",
          "order": 1,
          "title": "Place Top Straw",
          "description": "Move the top straw into position between the top-left and top-right connectors.",
          "actionIds": ["action_1"],
          "expectedResult": "Straw is positioned above and aligned.",
          "hints": ["Watch for snapping guidelines", "Align with connector ports"]
        },
        {
          "id": "step_2",
          "order": 2,
          "title": "Connect Top Straw",
          "description": "Attach the top straw to the connectors.",
          "actionIds": ["action_2"],
          "expectedResult": "Straw is connected at both ends",
          "hints": ["Snap into port", "Check alignment before connection"],
          "validation": {
            "type": "connection",
            "criteria": {
              "jointId": "joint_1",
              "connected": true
            }
          }
        },
        {
          "id": "step_3",
          "order": 3,
          "title": "Highlight Top Connection",
          "description": "Observe connection feedback on the top straw.",
          "actionIds": ["action_3"],
          "expectedResult": "Connection flashes to confirm success",
          "hints": ["Look for glowing connector effect"]
        },
        {
          "id": "step_4",
          "order": 4,
          "title": "Repeat for Bottom, Left, Right",
          "description": "Complete remaining sides of the square with similar steps.",
          "actionIds": [],
          "expectedResult": "All sides connected forming a square",
          "hints": ["Do same for each straw", "Ensure closed loop is formed"]
        }
      ],
      "playbackControls": {
        "allowRewind": true,
        "allowPause": true,
        "allowSkip": false,
        "speed": 1.0
      }
    }
  ]
